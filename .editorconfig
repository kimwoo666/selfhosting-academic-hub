root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[*.{yml,yaml,json}]
indent_size = 2

[*.sh]
indent_size = 4

[jarvis-cpp-academic-hub/*.ts]
indent_size = 4

[jarvis-cpp-academic-hub/*.tsx]
indent_size = 4
